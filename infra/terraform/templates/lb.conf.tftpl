# Generated by Terraform - round-robin load balancer in front of the app containers.
upstream app {
%{ for name in backends ~}
    server ${name}:80 max_fails=2 fail_timeout=10s;
%{ endfor ~}
}

server {
    listen 80;
    server_tokens off;

    location / {
        proxy_pass http://app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_next_upstream error timeout http_502 http_503;
        add_header X-Upstream $upstream_addr always;
    }
}

# Internal metrics for the nginx exporter (not published to the host).
server {
    listen 8081;
    access_log off;

    location = /stub_status {
        stub_status;
    }
}
